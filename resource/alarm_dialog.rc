/**
 * @file alarm_dialog.rc
 * @brief Alarm configuration dialog
 */
#include <windows.h>
#include "resource.h"

#pragma code_page(65001)

/** @brief Alarm time and message configuration dialog */
CLOCK_IDD_ALARM_DIALOG DIALOGEX 0, 0, 240, 210
STYLE DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_APPWINDOW
CAPTION "Set Alarm"
FONT 9, "Segoe UI"
BEGIN
    GROUPBOX        "Alarm Time", IDC_ALARM_TIME_LABEL, 10, 10, 220, 50
    LTEXT           "Time (HH:MM):", CLOCK_IDC_STATIC, 20, 30, 60, 12
    EDITTEXT        IDC_ALARM_TIME_EDIT, 90, 28, 100, 14, ES_AUTOHSCROLL

    GROUPBOX        "Alarm Message", IDC_ALARM_MESSAGE_LABEL, 10, 65, 220, 45
    EDITTEXT        IDC_ALARM_MESSAGE_EDIT, 20, 82, 200, 20, ES_AUTOHSCROLL

    GROUPBOX        "Repeat", IDC_ALARM_DAYS_GROUP, 10, 115, 220, 68
    AUTOCHECKBOX    "One-time", IDC_ALARM_RECURRING_CHECK, 20, 127, 60, 12
    AUTOCHECKBOX    "Daily", IDC_ALARM_DAILY_CHECK, 90, 127, 50, 12
    AUTOCHECKBOX    "Sun", IDC_ALARM_DAY_SUNDAY, 20, 146, 42, 12
    AUTOCHECKBOX    "Mon", IDC_ALARM_DAY_MONDAY, 67, 146, 42, 12
    AUTOCHECKBOX    "Tue", IDC_ALARM_DAY_TUESDAY, 114, 146, 42, 12
    AUTOCHECKBOX    "Wed", IDC_ALARM_DAY_WEDNESDAY, 161, 146, 48, 12
    AUTOCHECKBOX    "Thu", IDC_ALARM_DAY_THURSDAY, 20, 164, 42, 12
    AUTOCHECKBOX    "Fri", IDC_ALARM_DAY_FRIDAY, 67, 164, 42, 12
    AUTOCHECKBOX    "Sat", IDC_ALARM_DAY_SATURDAY, 114, 164, 42, 12

    PUSHBUTTON      "OK", IDOK, 170, 188, 60, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 100, 188, 60, 14
END
